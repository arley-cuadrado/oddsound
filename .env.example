# Database connection string
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/oddsound?retryWrites=true&w=majority&appName=ClusterName

# Or use a PG connection string
# DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=replace-with-a-long-random-secret

# Used to validate preview requests
PREVIEW_SECRET=replace-with-a-long-random-secret

# Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_replace_with_your_resend_api_key
# SMTP transport verification is skipped outside Vercel production builds

# Sender identity
EMAIL_FROM_ADDRESS=hello@mail.oddsound.co
EMAIL_FROM_NAME=oddsound

# Optional. Comma-separated list for infrastructure-safe superadmins
SUPER_ADMIN_EMAILS=arley.cuadrado@icloud.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token

# Google OAuth for consumer login/register
GOOGLE_OAUTH_CLIENT_ID=google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=google_oauth_client_secret
# Defaults to http://localhost:3000/consumer-api/auth/google/callback when omitted locally
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/consumer-api/auth/google/callback

# Mercado Pago OAuth
MERCADOPAGO_CLIENT_ID=mercado_pago_client_id
MERCADOPAGO_CLIENT_SECRET=mercado_pago_client_secret
MERCADOPAGO_WEBHOOK_TOKEN=replace-with-a-random-webhook-token
MARKETPLACE_PLATFORM_FEE_PERCENT=12
MARKETPLACE_USD_TO_COP_RATE=4000
MARKETPLACE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
